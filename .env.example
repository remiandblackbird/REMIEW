# Copy this file to .env and fill in your key — never commit the real .env file.
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — override the Claude model the backend uses (defaults to claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# Optional — how much the model "thinks" per request: low | medium | high | xhigh | max
# CLAUDE_EFFORT=medium

# Optional — port the local server listens on (defaults to 3000)
# PORT=3000
